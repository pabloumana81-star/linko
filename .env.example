# Local default. A production release must override this with supabase.
# LinkO backend mode: mock or supabase
BACKEND_MODE=mock

# Required only when BACKEND_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Exact native callback. Do not replace it with an external URL or wildcard.
AUTH_REDIRECT_URL=io.supabase.linko://login-callback/
